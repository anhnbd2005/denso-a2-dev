# DENSO A2 - safe per-machine OpenAI-compatible configuration
# Copy this file to .env and replace the placeholders on each teammate's PC.
# Never commit .env or a real credential.

OPENAI_COMPAT_ENABLED=true
OPENAI_COMPAT_BASE_URL=https://YOUR_REACHABLE_PROVIDER/v1
OPENAI_COMPAT_MODEL=deepseek-v4-flash
OPENAI_COMPAT_API_KEY=YOUR_PRIVATE_API_KEY
